# Supabase Configuration (copy to .env.local and fill in)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider API keys are configured server-side via Supabase Edge Function secrets.
# Do NOT use VITE_AI_* prefix — those would be exposed in the client bundle.

# Sentry Configuration — REQUIRED for production error reporting (DR-34)
# Get your DSN from https://sentry.io/settings/projects/
# If not set in production, a console warning will be shown.
VITE_SENTRY_DSN=

# Sentry Configuration
VITE_SENTRY_DSN=
